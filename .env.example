# Copy this file to ".env" (repo root) and fill in real values as needed.
# Never commit the actual ".env" file -- only this example should be shared.

# "fake" = zero cost, zero network calls, always returns "unclear".
# "real" = actually calls your LLM provider (costs money, needs a real key below).
LLM_MODE=fake

# Which AI service to use: "anthropic" or "openrouter".
LLM_PROVIDER=anthropic

# Only needed when LLM_MODE=real and LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed when LLM_MODE=real and LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
