# PostgreSQL: Zero to Production - Global Environment Variables
# One file for the whole course. Every notebook loads it with load_dotenv("../../.env").
# Fill in your own values. Do NOT commit this file to version control.

# Server address and port of your PostgreSQL instance
PGHOST=localhost
PGPORT=5432

# Login role and password (leave the password empty only if your server trusts local connections)
PGUSER=postgres
PGPASSWORD=

# Database the lessons connect to
PGDATABASE=university

# TLS mode: disable, prefer, require, verify-full (managed cloud services usually need require)
PGSSLMODE=prefer
